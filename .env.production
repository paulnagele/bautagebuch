# Public settings used by the production build (GitHub Pages).
# None of these are secrets: they all end up in the browser.
# Repository variables with the same name minus the VITE_ prefix
# (e.g. SUPABASE_URL) override these values in the GitHub Actions build.

# Google Cloud → Google Auth Platform → Clients → Web client
VITE_GOOGLE_CLIENT_ID=473191997634-71dq3c3vdmvqr9bcq4v81ikd6rb7coee.apps.googleusercontent.com
# Supabase → Project Settings → API (Project URL, anon/publishable key)
VITE_SUPABASE_URL=https://uoeagpimikeqxorjgvls.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_GzyyiBrAKkfcrdm07hpdKA_Lb1CDOhW
# The shared Google Drive folder for photos: the last part of its URL,
# https://drive.google.com/drive/folders/<this part>
VITE_DRIVE_FOLDER_ID=1CfIpLEQnRyC1VBHdhHwsvC9S7kfdhptm
